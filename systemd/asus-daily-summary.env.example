# Copy to ~/.config/asus-daily/asus-daily-summary.env and edit for your host.
# Find the target host's system ID in your own Beszel instance.
BESZEL_SYSTEM_ID=replace-with-your-own-system-id

# Optional: shown as a link in the report; does not configure DB connectivity.
# BESZEL_URL=

# Optional: override the default ~/services/beszel/data/data.db path.
# Use an absolute path if your database is stored elsewhere.
# BESZEL_DB=/absolute/path/to/data.db

# Optional: report search directories separated by ':' on Linux.
# ROOT_PATROL_DIRS=/path/to/patrol-reports:/var/log/old-asus-auto-check
